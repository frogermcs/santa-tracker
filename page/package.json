{
  "name": "m5stick-santa-tracker",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "package:firmware": "node ../scripts/package-firmware.mjs --rebuild",
    "package:firmware:quick": "node ../scripts/package-firmware.mjs",
    "ingest": "node ../scripts/ingest-schedule.mjs",
    "test:unit": "vitest run",
    "test:schedule": "node --experimental-strip-types ../scripts/test-api.mjs",
    "test": "npm run typecheck && npm run test:unit && npm run test:schedule"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "esp-web-tools": "^10.4.0",
    "improv-wifi-serial-sdk": "^2.8.0",
    "lucide-react": "^1.16.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  }
}
